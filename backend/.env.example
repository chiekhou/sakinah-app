# Configuration du serveur
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=sakinah_app_db
PG_USER=your_postgres_user
PG_PASSWORD=your_postgres_password

# Base de données MongoDB
MONGO_URI=mongodb://admin:password@localhost:27017/

# JWT Secret (générer une clé unique pour la production)
JWT_SECRET=your_jwt_secret_key_here

# API IA (Anthropic)
AI_API_KEY=your_anthropic_api_key
AI_API_URL=https://api.anthropic.com/v1/messages

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Configuration Email (Brevo API)
# Obtenir la clé API sur: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-api-key-here
SMTP_FROM_EMAIL=noreply@sakinah.app
SMTP_FROM_NAME=Sakinah

# Frontend URL (pour les liens dans les emails - deep links)
# En production: https://sakinah-app.onrender.com
FRONTEND_URL=http://localhost:3000

# Autres
MAX_UPLOAD_SIZE=10485760
