# Configuration du serveur
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL (via Docker)
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=mental_health_db
PG_USER=mental_health_user
PG_PASSWORD=mental_health_password_2024

# Base de données MongoDB (via Docker)
MONGO_URI=mongodb://admin:admin_password_2024@mongodb:27017/mental_health_chat?authSource=admin

# JWT Secret (CHANGEZ CETTE CLÉ EN PRODUCTION)
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production_min_32_chars

# API IA (Anthropic ou OpenAI)
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://api.anthropic.com/v1/messages

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Autres
MAX_UPLOAD_SIZE=10485760
